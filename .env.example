# Create an API key at https://console.groq.com/keys
GROQ_API_KEY=

# The default run compares Qwen 3.6 27B and GPT-OSS 20B on GroqCloud.

# PostgreSQL connection used by the FastAPI backend and Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/llm_evaluation
DATABASE_ECHO=false

# Use "celery" after starting Redis and a worker; "inprocess" needs neither.
TASK_BACKEND=inprocess
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
READINESS_TIMEOUT_SECONDS=1
CELERY_METRICS_ENABLED=true
CELERY_METRICS_HOST=127.0.0.1
CELERY_METRICS_PORT=9808

# Local Prometheus/Grafana stack from compose.observability.yaml.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-production

# Generate a random value with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call FastAPI during local frontend development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Structured backend logs. Use LOG_FORMAT=text for easier local reading.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional distributed tracing to the local Tempo OTLP/HTTP receiver.
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORT_TIMEOUT_SECONDS=5
OTEL_TRACE_SAMPLE_RATIO=1.0
TEMPO_HTTP_PORT=3200
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Optional external error reporting. Create a project and copy its DSN from Sentry.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ERROR_SAMPLE_RATE=1.0
