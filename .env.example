# Create an API key at https://console.groq.com/keys
GROQ_API_KEY=

# The default run compares Qwen 3.6 27B and GPT-OSS 20B on GroqCloud.

# PostgreSQL connection used by the FastAPI backend and Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/llm_evaluation
DATABASE_ECHO=false

# Use "celery" after starting Redis and a worker; "inprocess" needs neither.
TASK_BACKEND=inprocess
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Generate a random value with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call FastAPI during local frontend development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
