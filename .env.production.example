# Public hostname and certificate-registration email. Point the hostname's
# DNS A/AAAA record at the server before starting Caddy.
APP_DOMAIN=evalflow.example.com
ACME_EMAIL=ops@example.com

# Immutable images published by the v0.37.0 Git tag. The protected deployment
# workflow rewrites these three values to the approved version automatically.
EVALFLOW_API_IMAGE=ghcr.io/foreg0n/llm-evaluation-platform-api:0.37.0
EVALFLOW_FRONTEND_IMAGE=ghcr.io/foreg0n/llm-evaluation-platform-frontend:0.37.0
EVALFLOW_BACKUP_IMAGE=ghcr.io/foreg0n/llm-evaluation-platform-backup:0.37.0

POSTGRES_DB=llm_evaluation
POSTGRES_USER=postgres
# Use URL-safe hexadecimal values to avoid escaping connection URLs.
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
REDIS_PASSWORD=replace-with-64-random-hex-characters

# Generate independently; never reuse or commit production secrets.
AUTH_SECRET_KEY=replace-with-64-random-hex-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
MODEL_CATALOG_TIMEOUT_SECONDS=10
MODEL_CATALOG_CACHE_TTL_SECONDS=300

# Encrypted off-site PostgreSQL backups through restic. This example targets
# an S3-compatible bucket; adapt the endpoint for AWS S3, Backblaze B2,
# Cloudflare R2, MinIO, or another restic backend.
RESTIC_REPOSITORY=s3:https://s3.example.com/evalflow-production/postgres
RESTIC_PASSWORD=replace-with-a-separate-restic-encryption-password
RESTIC_HOST=evalflow-production
AWS_ACCESS_KEY_ID=replace-with-object-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-object-storage-secret-key
AWS_DEFAULT_REGION=auto
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=300
BACKUP_MAX_AGE_SECONDS=90000
BACKUP_RUN_ON_START=true
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=12
BACKUP_PRUNE=true
RESTORE_MIN_PUBLIC_TABLES=8

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# SMTP is recommended for public deployments. Console prints links only to logs.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_BACKEND=smtp
EMAIL_FROM_ADDRESS=no-reply@evalflow.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_STARTTLS=true

# Optional external observability. Keep disabled when endpoints are not set.
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces
OTEL_TRACE_SAMPLE_RATIO=0.1
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ERROR_SAMPLE_RATE=1.0

# Optional legacy server-side provider fallback. Web users normally use BYOK.
GROQ_API_KEY=
